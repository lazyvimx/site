{
	"name": "lazyvimx-site",
	"type": "module",
	"version": "1.9.0",
	"private": true,
	"license": "MIT",
	"engines": {
		"node": "26.11.1"
	},
	"scripts": {
		"docs:sync": "node scripts/sync-docs.ts",
		"predev": "npm run docs:sync",
		"dev": "astro dev",
		"prebuild": "npm run docs:sync",
		"build": "astro build && pagefind --site dist",
		"preview": "astro preview",
		"check": "npm run docs:sync && astro check && svelte-check",
		"test": "node --test 'src/**/*.test.ts'",
		"test:e2e": "playwright test",
		"astro": "astro",
		"format": "oxlint --fix && prettier --write .",
		"format:check": "prettier --check .",
		"lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
		"lint:js": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "0.4.3",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/svelte": "9.0.1",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"astro": "7.3.8",
		"satteri": "0.10.5",
		"svelte": "5.57.2"
	},
	"devDependencies": {
		"@aimuzov/infra-site-kit": "github:aimuzov/infra-site-kit#v5.8.1",
		"@astrojs/check": "0.9.10",
		"@csstools/postcss-global-data": "4.0.0",
		"@lucide/svelte": "1.39.0",
		"@playwright/test": "1.64.0",
		"@shikijs/themes": "4.5.0",
		"@types/hast": "3.0.5",
		"@types/mdast": "4.0.4",
		"@types/node": "26.6.5",
		"oxlint": "1.88.0",
		"pagefind": "1.5.2",
		"postcss-custom-media": "12.0.3",
		"postcss-nested": "8.0.1",
		"prettier": "3.9.10",
		"stylelint": "17.16.0",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"unist-util-visit": "5.1.0"
	},
	"imports": {
		"#frontend/*": "./src/frontend/*",
		"#sync/*": "./src/sync/*"
	}
}
