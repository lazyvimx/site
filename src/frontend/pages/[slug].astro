---
import { getCollection, render } from 'astro:content'

import Doc from '#frontend/layouts/doc.astro'

export async function getStaticPaths() {
	const docs = await getCollection('docs', (entry) => entry.id.startsWith('en/'))

	return docs.map((entry) => ({ params: { slug: entry.id.slice(3) }, props: { entry } }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
---

<Doc lang="en" slug={Astro.params.slug} title={entry.data.title} description={entry.data.description} {headings}>
	<Content />
</Doc>
